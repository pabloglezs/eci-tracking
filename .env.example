# Copia a .env para `docker compose up` en local. En Portainer, estas variables
# se definen en la sección "Environment variables" del stack.

PORT=3000
TZ=Europe/Madrid
PUBLIC_URL=http://localhost:3000

# Comprobación diaria a las 7:00 (formato cron)
CHECK_CRON=0 7 * * *
CHECK_ON_START=false
TRUST_PROXY=false
ADMIN_TOKEN=

# SMTP para los avisos por email. Sin SMTP los emails quedan en cola.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ECI Tracker <alertas@tudominio.com>
# true = escribe los emails en el log en vez de enviarlos (para probar)
MAIL_DRY_RUN=false

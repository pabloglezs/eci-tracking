# Copia a .env para `docker compose up` en local. En Portainer, estas variables
# se definen en la sección "Environment variables" del stack.

PORT=3000
# Interfaz del host donde se publica el puerto. 0.0.0.0 = todas.
# Con túnel de Cloudflare apuntando a 172.17.0.1: BIND_ADDR=172.17.0.1
BIND_ADDR=0.0.0.0
TZ=Europe/Madrid
PUBLIC_URL=http://localhost:3000

# Comprobación diaria a las 7:00 (formato cron)
CHECK_CRON=0 7 * * *
CHECK_ON_START=false
TRUST_PROXY=false
ADMIN_TOKEN=

# Aviso al admin si una pasada diaria falla en bloque (vacío = desactivado)
ADMIN_EMAIL=

# Backups de la BD (cron; "off" lo desactiva) y nº de copias. Para guardarlos en
# otro disco del host: BACKUP_PATH=/ruta/en/otro/disco
BACKUP_CRON=30 3 * * *
BACKUP_KEEP=7
# BACKUP_PATH=

# Todas las demás variables (reintentos del scraper, límites por IP, caducidad de
# confirmaciones, purga de la cola…) tienen valores por defecto sensatos: ver la
# tabla «Variables de entorno» del README.

# SMTP para los avisos por email. Sin SMTP los emails quedan en cola.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ECI Tracker <alertas@tudominio.com>
# true = escribe los emails en el log en vez de enviarlos (para probar)
MAIL_DRY_RUN=false
